// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("user") // user, admin, partner
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rooms            Room[]
  courses          Course[]
  payments         Payment[]
  roomParticipants RoomParticipant[]
  coursePurchases  CoursePurchase[]

  @@map("users")
}

model Room {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  slug            String   @unique
  roomType        String   @default("general") @map("room_type")
  description     String?  @db.Text
  maxParticipants Int      @default(200) @map("max_participants")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]

  @@index([userId])
  @@index([slug])
  @@map("rooms")
}

model RoomParticipant {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_participants")
}

model Course {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  fileUrl      String?  @map("file_url") @db.Text
  fileName     String?  @map("file_name")
  fileSize     BigInt?  @map("file_size")
  category     String?
  isPublished  Boolean  @default(false) @map("is_published")
  downloadCount Int    @default(0) @map("download_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases CoursePurchase[]

  @@index([userId])
  @@index([isPublished])
  @@map("courses")
}

model CoursePurchase {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  userId        String   @map("user_id")
  amountPaid    Decimal  @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus String   @default("pending") @map("payment_status")
  purchasedAt   DateTime @default(now()) @map("purchased_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_purchases")
}

model Payment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  amount        Decimal  @db.Decimal(10, 2)
  paymentType   String   @map("payment_type") // subscription, course, room
  status        String   @default("pending") // pending, completed, failed, refunded
  paymentMethod String?  @map("payment_method")
  transactionId String? @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payments")
}
